NODE_ENV=development
PORT=3333
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_MAX_AGE_MS=3600000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BODY_LIMIT=100kb

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=online_shopping_cart

# Optional. Order checkout remains available when email is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
